SK= # Your private key
PK= # Your public key
MINERS= # Number of threads for parallel mining (0 to disable, defaults to CPU count)
MINER_TYPE= # Mining backend: js or rust (defaults to js)
RUST_MINER_PATH= # Path to the rust miner binary (defaults to ../blake2s-gpu-miner/target/release/miner)
PORT= # Server listening port (defaults to 18018)